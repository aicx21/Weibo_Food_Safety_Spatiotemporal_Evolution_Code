   "source": [
    "#词云图\n",
    "from wordcloud import WordCloud\n",
    "import matplotlib.pyplot as plt\n",
    "from collections import Counter\n",
    "\n",
    "# 合并所有文本为一个字符串\n",
    "all_text = ' '.join(df['ProcessedText'])\n",
    "\n",
    "# 统计词语频率\n",
    "words = all_text.split()\n",
    "word_counts = Counter(words)\n",
    "\n",
    "# 筛选出频率前100的词语\n",
    "top_100_words = dict(word_counts.most_common(100))\n",
    "\n",
    "# 创建词云对象，使用频率前100的词语\n",
    "wordcloud = WordCloud(\n",
    "    width=800, \n",
    "    height=400, \n",
    "    background_color='white', \n",
    "    font_path='msyh.ttc'\n",
    ").generate_from_frequencies(top_100_words)\n",
    "\n",
    "# 显示词云图\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.imshow(wordcloud, interpolation='bilinear')\n",
    "plt.axis('off')  # 关闭坐标轴\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c78adb7b-2980-486b-9b89-48dd9ebd9c06",
   "metadata": {},
   "outputs": [],
   "source": [
    "#困惑度\n",
    "import matplotlib.pyplot as plt\n",
    "from gensim.models import LdaModel\n",
    "from gensim.corpora import Dictionary\n",
    "from gensim import corpora\n",
    "# 创建字典\n",
    "texts = [text.split() for text in df['ProcessedText']]\n",
    "dictionary = Dictionary(texts)\n",
    "\n",
    "# 创建语料库\n",
    "corpus = [dictionary.doc2bow(text) for text in texts]\n",
    "\n",
    "# 确定我们想要测试的主题数量范围\n",
    "topic_nums = list(range(2, 12, 1))\n",
    "\n",
    "# 存储每个模型的困惑度\n",
    "perplexities = []\n",
    "\n",
    "for num_topics in topic_nums:\n",
    "    # 训练LDA模型\n",
    "    lda_model = LdaModel(corpus=corpus, id2word=dictionary, num_topics=num_topics, passes=10)\n",
    "    \n",
    "   # 计算并存储困惑度\n",
    "    perplexity = lda_model.log_perplexity(corpus)\n",
    "    perplexities.append(perplexity)\n",
    "\n",
    "# 绘制困惑度曲线\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.plot(topic_nums, perplexities, marker='o')\n",
    "plt.xlabel(\"Number of Topics\")\n",
    "plt.ylabel(\"Log Perplexity\")\n",
    "plt.title(\"LDA Model Perplexity\")\n",
    "plt.xticks(topic_nums)\n",
    "plt.show()"
   ]
  },
  {
