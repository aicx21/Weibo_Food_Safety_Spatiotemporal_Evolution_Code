   "source": [
    "#LDA可视化\n",
    "import pyLDAvis.gensim_models as gensimvis\n",
    "import pyLDAvis\n",
    "import os\n",
    "\n",
    "# 训练LDA模型\n",
    "lda_model = models.LdaModel(corpus, num_topics=6, id2word=dictionary, passes=15)\n",
    "\n",
    "# 可视化并保存LDA模型\n",
    "visualization = gensimvis.prepare(lda_model, corpus, dictionary)\n",
    "pyLDAvis.save_html(visualization, \"LDA_Visualization.html\")\n",
    "\n",
    "# 如果需要在Jupyter Notebook中显示可视化结果，可以使用下面的代码\n",
    "pyLDAvis.display(visualization)"
   ]
  }
